# Copiar como `.env` si hace falta. En desarrollo no es necesario: Vite hace
# proxy de /api hacia el backend (ver vite.config.ts), así que el formulario
# funciona sin configurar nada.

# URL del backend en producción, sin barra final.
# Dejar vacío si el frontend y la API se sirven desde el mismo dominio.
# Ej: https://api.toolsdevs.com
VITE_API_URL=
