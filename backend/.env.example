# Copiar este archivo como `.env` y completar los valores.
# El .env real nunca se sube al repositorio.

NODE_ENV=development
PORT=3001

# Orígenes autorizados a consumir la API, separados por coma.
# En producción va el dominio real: https://toolsdevs.com,https://www.toolsdevs.com
CORS_ORIGINS=http://localhost:5173

# Envío de mails (https://resend.com). Sin estas tres variables el servidor
# arranca igual, pero el formulario no manda nada.
RESEND_API_KEY=
MAIL_FROM=ToolsDevs <web@toolsdevs.com>
MAIL_TO=devstools.arg@gmail.com

# Límite de envíos del formulario por IP.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# Cuántos proxies hay delante del servidor (0 en local, 1 detrás de Nginx).
TRUST_PROXY_HOPS=0

# Panel de administración (/admin en el frontend). Sin estas tres variables el
# login queda deshabilitado. Generar el hash con:
#   npm run hash-password -w backend -- "tu-contraseña"
ADMIN_EMAIL=admin@toolsdevs.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Persistencia de empresas/equipo/producto vía la API de GitHub (necesario en
# Vercel, donde el filesystem es de solo lectura). Dejar todo vacío en local:
# sin GITHUB_TOKEN el servidor guarda los JSON en disco (backend/data) y
# listo, no hace falta configurar nada para desarrollar.
#
# El token es un fine-grained personal access token
# (https://github.com/settings/tokens?type=beta) con acceso sólo a este
# repo y permiso "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_OWNER=LuquitasLeon
GITHUB_REPO=TooLsdevs
GITHUB_DATA_BRANCH=cms-data
